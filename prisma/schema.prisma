// Les URL de connexion sont dans prisma.config.ts (CLI) et
// src/lib/db/prisma.ts (application).
datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  // Charge une fiche et toutes ses listes en une requête SQL (JOIN) au lieu
  // d'une requête par relation : 2 requêtes au lieu de 24 pour une fiche.
  previewFeatures = ["relationJoins"]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  role      Role      @default(USER)
  sheets    Sheet[]
  xpEntries XpEntry[]

  // Réglages de l'interface (thème, densité, sections repliées), suivis d'un
  // appareil à l'autre. Forme validée par l'API (src/lib/preferences.ts).
  preferences Json?

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum Role {
  USER
  ADMIN
}

model Sheet {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams  Team[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Visage
  name        String?
  avatar      String?
  age         Int?
  current_mai Int?
  aspect      String? @default("Type")
  become      String? @default("10") // Devenir
  tint        String? // Teinte de lune choisie pour le personnage (src/lib/tints.ts)

  // Caractères
  strength      Int? @default(25) // force
  agility       Int? @default(25) // agilité
  vivacity      Int? @default(25) // vivacité
  vigour        Int? @default(25) // vigueur
  thinking      Int? @default(25) // raisonnement
  perception    Int? @default(25) // perception
  concentration Int? @default(25) // concentration
  understanding Int? @default(25) // entendement
  charisma      Int? @default(25) // charisme
  empathy       Int? @default(25) // empathie
  ego           Int? @default(25) // ego
  will          Int? @default(25) // volonté

  // Existences : valeurs courantes (vide = au maximum, les maximums sont calculés)
  current_health    Int?
  current_stability Int?
  current_radiance  Int?

  // Expérience : journal des XP (attribuées, dépensées, remboursées…) et
  // parties de la fiche encore modifiables librement (création ou reset du
  // MJ), payées à la validation. Voir src/lib/rules/xp.ts.
  xpEntries XpEntry[]
  unlocked  String[]  @default(["body", "spirit", "soul", "general", "spyral", "martial", "corpus", "spyree"]) @map("xp_unlocked")

  // Schémas
  corpus Corpus[]
  spyree Spyree[]
  amee   Amee[]

  traits Trait[]
  skills SheetSkill[]
  spells Spell[]
  golems Golem[]

  // Équipement
  armors       Armor[]
  meleeWeapons MeleeWeapon[]
  rangeWeapons RangeWeapon[]
  items        Item[]

  notes String? @default("")
}

// Journal d'expérience d'une fiche. Montants positifs ; leur effet dépend
// du type d'écriture.
enum XpKind {
  GAIN // XP attribuée par le MJ (négative s'il en retire)
  SPEND // achat
  REFUND // remboursement d'un élément baissé ou retiré
  LOSS // élément retiré sans remboursement : l'XP est perdue
  GIFT // élément offert par le MJ (valeur dans `offered`)
}

model XpEntry {
  id        String   @id @default(cuid())
  seq       Int      @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  sheetId   String   @map("sheet_id")
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  authorId  String?  @map("author_id")
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      XpKind
  feel      Int      @default(0) // éprouver
  learn     Int      @default(0) // apprendre
  live      Int      @default(0) // vivre
  offered   Int      @default(0)
  // Élément concerné : char:strength, skill:<id>, corpus, spyree:<id>, legacy
  target    String?
  // Partie de la fiche : body, spirit, soul, general, spyral, martial, corpus, spyree
  scope     String?
  label     String
  // Écritures faites ensemble (validation, reset, distribution…)
  batch     String?

  @@index([sheetId])
}

model Whitelist {
  id    String @id @default(cuid())
  email String @unique
}

model Team {
  id      String  @id @default(cuid())
  name    String? @unique
  members Sheet[]
}

// ---------------------------------------------------------------------------
// Catalogues de règles (remplis par prisma/seeds)
// ---------------------------------------------------------------------------

// Origine, Adaptation, Stature, Apparence…
model CorpusType {
  id     String   @id @default(cuid())
  name   String   @unique
  corpus Corpus[]
}

// Élément > Le Feu > Flamme…
model PotentialCategory {
  id   String @id @default(cuid())
  name String @unique

  types PotentialType[]
}

model PotentialType {
  id   String @id @default(cuid())
  name String @unique

  categoryId String            @map("category_id")
  category   PotentialCategory @relation(fields: [categoryId], references: [id])
  potentials Potential[]
}

model Potential {
  id          String        @id @default(cuid())
  typeId      String        @map("type_id")
  type        PotentialType @relation(fields: [typeId], references: [id])
  name        String        @unique
  description String
  spyrees     Spyree[]
}

enum SkillType {
  GENERAL
  SPYRAL
  MARTIAL
}

enum SkillDegree {
  BASE
  PRINCIPLE
  MASTERY
  TECHNIQUE
  SEQUENCE
}

// Compétences : une catégorie (Athlétisme) contient des bases, des principes
// et des maîtrises ; chacun peut exiger un des prérequis listés.
model Skill {
  id            String      @id @default(cuid())
  name          String
  description   String?
  type          SkillType
  category      String
  degree        SkillDegree
  prerequisites Skill[]     @relation("SkillDependencies")
  dependencies  Skill[]     @relation("SkillDependencies")

  sheets            SheetSkill[] @relation("sheets")
  prerequisiteSheet SheetSkill[] @relation("prerequisiteSheet")

  @@unique([name, category])
}

// Propriétés d'équipement : Entravante, Pesante, Déployable…
model Property {
  id          String  @id @default(cuid())
  name        String?
  description String?

  armors       Armor[]
  meleeWeapons MeleeWeapon[]
  rangeWeapons RangeWeapon[]
}

// ---------------------------------------------------------------------------
// Contenu des fiches
// ---------------------------------------------------------------------------

// Le Corpus : un type (Origine…), un nom, et un bonus éventuel à un caractère
// (ou à la santé : stat = "health") qui s'ajoute aux marges des facultés.
model Corpus {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now()) @map("created_at")
  typeId      String     @map("type_id")
  type        CorpusType @relation(fields: [typeId], references: [id])
  name        String?
  description String?
  stat        String?
  bonus       Int?
  sheetId     String     @map("sheet_id")
  sheet       Sheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model Spyree {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  level       Int?      @default(1)
  sheetId     String    @map("sheet_id")
  sheet       Sheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  potentialId String    @map("potential_id")
  potential   Potential @relation(fields: [potentialId], references: [id])
}

model Amee {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  name        String?
  description String?
  sheetId     String   @map("sheet_id")
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model Trait {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  name        String?
  description String?
  balance     Int?
  inborn      Boolean  @default(true) // inné ou acquis
  sheetId     String   @map("sheet_id")
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

// Compétence acquise par un personnage. `prerequisite` indique par quel
// prérequis elle a été obtenue quand la compétence en accepte plusieurs.
model SheetSkill {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @map("created_at")
  suffixe        String?
  prerequisiteId String?  @map("prerequisite_id")
  prerequisite   Skill?   @relation("prerequisiteSheet", fields: [prerequisiteId], references: [id])
  skillId        String   @map("skill_id")
  skill          Skill    @relation("sheets", fields: [skillId], references: [id])
  sheetId        String   @map("sheet_id")
  sheet          Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model Spell {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  name        String?
  incantation String?
  targeting   String?
  duration    String?
  effect      String?
  sheetId     String   @map("sheet_id")
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model Golem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  name      String?
  artefact  String?
  symbiosis String?
  heart     String?
  sheetId   String   @map("sheet_id")
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

enum ArmorType {
  LOW
  PARTIAL
  FULL
}

model Armor {
  id                 String     @id @default(cuid())
  createdAt          DateTime   @default(now()) @map("created_at")
  name               String?
  protection         Int? // protection maximale
  current_protection Int?
  index              Int? // indice
  type               ArmorType?
  bulk               Int? // encombrement (%)
  solidity           Int?       @map("strength")
  prerequisite_stat  String?
  prerequisite_value Int?
  properties         Property[]
  quality            Int?
  equipped           Boolean    @default(true)
  sheetId            String     @map("sheet_id")
  sheet              Sheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model MeleeWeapon {
  id                 String     @id @default(cuid())
  createdAt          DateTime   @default(now()) @map("created_at")
  name               String?
  damage             Int?
  extend             Int? // allonge
  bulk               Int? // encombrement (%)
  solidity           Int?       @map("strength")
  prerequisite_stat  String?
  prerequisite_value Int?
  properties         Property[]
  quality            Int?
  equipped           Boolean    @default(true)
  sheetId            String     @map("sheet_id")
  sheet              Sheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model RangeWeapon {
  id                 String     @id @default(cuid())
  createdAt          DateTime   @default(now()) @map("created_at")
  name               String?
  damage             Int?
  penetration_damage Int?
  velocity           Int?
  rate               Int? // cadence
  reload_rate        Int? // rechargement
  range              String?
  low_range          Int? // portée courte
  medium_range       Int? // portée moyenne
  long_range         Int? // portée longue
  bulk               Int? // encombrement (%)
  solidity           Int?       @map("strength")
  prerequisite_stat  String?
  prerequisite_value Int?
  properties         Property[]
  quality            Int?
  equipped           Boolean    @default(true)
  sheetId            String     @map("sheet_id")
  sheet              Sheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model Item {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  name        String?
  description String?
  quantity    Int?     @default(1)
  sheetId     String   @map("sheet_id")
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}
